# Render supplies PORT automatically.
PORT=10000
# Netlify site URL; multiple comma-separated origins are supported.
FRONTEND_URL=https://your-frontend.netlify.app
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-database-name
# Or use MYSQL_URL=mysql://user:password@host:3306/database
# Set a strong admin account through your own database/admin provisioning process.
